# =============================================================
#  Cấu hình Trợ lý ảo Giáo viên
#  Sao chép tệp này thành ".env" rồi điền các giá trị cần thiết.
# =============================================================

# Tên hiển thị trên giao diện
APP_NAME=Trợ lý ảo Giáo viên

# Địa chỉ người khác truy cập được tới máy chủ (dùng cho link xem đề và webhook).
# Chạy trên máy cá nhân thì để nguyên.
PUBLIC_BASE_URL=http://localhost:8000

# Múi giờ hiển thị
TIMEZONE=Asia/Ho_Chi_Minh

# Cho phép tự đăng ký thêm tài khoản giáo viên (tài khoản đầu tiên luôn được tạo)
ALLOW_REGISTRATION=false

# CSDL: để trống = SQLite tại data/app.db. Ví dụ PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/troly
DATABASE_URL=

# Khóa ký phiên đăng nhập: để trống = tự sinh và lưu ở data/.secret_key
SECRET_KEY=

# ---------------- AI (Google Gemini) ----------------
# Lấy khóa miễn phí tại https://aistudio.google.com/apikey
# Để trống = chạy CHẾ ĐỘ DEMO (điểm mô phỏng, trợ lý hiểu một số câu lệnh mẫu)
GEMINI_API_KEY=
# Bí danh luôn trỏ tới mô hình Flash mới nhất; có thể ghi tên cụ thể (xem ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=gemini-flash-latest
# auto | gemini | mock
AI_PROVIDER=auto

# ---------------- Chatbot Telegram ----------------
# Tạo bot: nhắn @BotFather trên Telegram -> /newbot -> nhận token
TELEGRAM_BOT_TOKEN=
# polling (chạy trên máy cá nhân, không cần tên miền) | webhook (máy chủ có HTTPS) | off
TELEGRAM_MODE=polling
# Bắt buộc khi dùng webhook: chuỗi bí mật bất kỳ (8-256 ký tự A-Z a-z 0-9 _ -)
TELEGRAM_WEBHOOK_SECRET=

# ---------------- Chatbot Zalo (thử nghiệm) ----------------
# Tạo bot tại https://bot.zaloplatforms.com -> lấy token
ZALO_BOT_TOKEN=
ZALO_MODE=polling
ZALO_WEBHOOK_SECRET=
# Đường dẫn mở bot Zalo (in lên phiếu QR cho học sinh)
ZALO_BOT_LINK=

# ---------------- Tác vụ nền ----------------
# Nhắc hạn trước bao nhiêu giờ
REMINDER_HOURS_BEFORE=12
# Bài có độ tin cậy AI dưới ngưỡng này được đánh dấu "cần xem kỹ"
LOW_CONFIDENCE_THRESHOLD=0.6
